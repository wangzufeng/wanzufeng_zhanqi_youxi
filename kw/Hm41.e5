ｼｮｼｻｻｼｼｼｼﾆﾆﾎｻﾆﾆﾒｻｻｱｱｱｼｼｻﾃｰｮｮｮｮｰｮｯｱｯｼﾃｯｯｯｯｮｯﾃｱﾒｱｼﾃｼｯﾆﾘﾆﾆｻｻｻｻｻﾆﾆｻｼｯｻｯｱｱｯｱｯｮｮｮｰｮｯｮｮｱｱｱｱｱｱｮｮｯｻｯｻﾒﾒﾒｻｻｻｯｮｮｯｯｮｮｯｯｯｯｱｱｰｮｯｯｯｮｮｱｯｯｮｯｮｮｮｯｯｯｯｮｰｮｱﾃｻｱｻｯｻｱｻｻﾖﾘﾘｮｮｮｯｮｮｯｯｯｱｱｯｮｮｯｱｱｯｰｮｯｱｯｮｮｮｯｮｱｯｮｮｯｮｮｼｮﾃｼｯｼｻｯｻｻﾆﾆﾆｮｰｯｯｮｮｯｯｯｱｱｱｯｮｯｯｮｯｰｮｮｱｯｯｮｮｯｯｱｮｯｯｯｯｮｯｱｯｯｮｮｱｯｱｰｮｮｮｮｮｮｯｮｰｮｯｯｯｱｯｯｮｯｯｮｯｰｰｮｱｮｯｮｯｱｱｱｱｱｯｯｯｮｯｱｯｮｮｱｯｯｯｰｮｮｮｮｮｮｰｮｮｯｱｯｯｯｮｮｱｯｯｯｯｮｮｯｯｮｮｮｯｯｱｯｮｯｯｮｮｯｯｯｱｮｯｱｮｮｰｮｮｯｮｮｮｰｰｰｯｯｯｮｯｯｯｯｯｯｮｯｯｮｰｮｮｮｮｯｮｱｱｯｮｱｱｮｰｯｮｮｯｰｮｮｮｮｯｮｮｯｮｮｰｰｰｮｯｯｯｯｯｮｯｱｯｮｰｮｮｮｰｮｮｯｮｮｯｱｱｯｮｱｱｮｮｯｯｮｮｰｮｮｮｮｱｯｮｱｮｮｰｰｰｮｱｱｮｯｯｮｯｱｮｰｰｮｮｮｮｮｯｯｮｮｯｯｱｯｮｯｱｮｯｯｮｮｯｯｮｯｱｱｯｮｮｱｯｯｮｮｰｮｱｯｰｮｯｯｱｯｮｮｮｮｮｮｮｮｯｱｯｯｱｮｯｯｯｮｱｯｯｮｮｯｱｱｯｯｱｱｯｯｱｱｱｯｮｮｰｮｯｮｮｮｯｯｯｯｯｯｮｮｮｮｮｮｯｱｮｮｯｮｮｯｱｮｯｯｱｱｱｱｱｯｱｱｯｯｱｯｱｱｱｯｮｰｮｯｯｮｮｯｮｮｯｯｯｯｮｯｮｮｮｯｯｯｮｮｮｯｯｯｯｮｯｮｯｱｰｰｮｱｱｯｰｰｮｮｯｯｮｮｮｮｮｯｱｯｰｮｯｰｮｮｮｯｯｮｮｮｮｯｯｮｯｮｮｯｱｮｯｮｮｮｯｯｰｮｮｱｯｯｰｰｰｯｱｮｮｮｮｮｮｮｮｮｰｮｮｮｯｯｱｯｰｮｮｰｯｯｮｮｯｯｮｮｯｯｯｮｮｯｮｯｰｰｰｮｮｯｰｰｮｮｱｯｯｮｮｮｰｮｮｮｰｱｮｰｮｯｯｯｮｮｰｰｯｯｮｮｮｮｮｮｮｮｮｮｮｮｯｮｰｰｸｰｮｮｰｸｮｮｯｮｱｮｮｮｮｮｰｰｮｯｰｰｰｰｮｮｯｯｰｰｮｱｮｮｮｮｮｯｮｮｮｰｮｮｯｯｮｰｸｸｰｰｸｸｮｰｮｮｯｮｮｮｮｮｮｰｰｮｸｰｸｰｰｮｱｯｮｰｮｱｯｮｮｯｮｱｮｮｮｰｮｯｯｯｮｮｸｰｮｰｸｸｰｰｮｮｮｰｮｮｮｮｮｰｰｰｸｰｰｮｰｮｯｮｰｰｮｯｱｯｮｯｯｱｯｰｰｰｮｮｮｰｯｮｰｮｰｸｰｸｰｮｱｯｮｰｮｮｯｮｯｯｮｰｰｯｮｮｰｯｮｰｰｮｯｯｱｯｱｯｱｱｮｮｮｰｰｸｰﾂｯｮｸｰｮｮｰｸｰｰｯｮｮｰｮｯｯｮｯｱｮｮｯｱｰｰｸｮｮｮｮｮｮｮｯｯｱｱｮｮｮｮｮｰｸｸｰｸｮｮｰｰｮｮｰｸｰｮｮｯｯｮｰｮｮｯｱｱｯｱｱｱｮｰｸｰｮｮｯｱｮｰｰｸｮｮｱｮｯｮｰｯｯｰｱｯｰｰｰｰｮｰｰｰｮｮｮｮｱｯｮｮｮｯｱｱｱｯｱｱｯｰｮｰｰｯｱｱｮｯｮｰｮｱｮｯｮｰｯｯｱｰｱｯｯｮｮｰｸｰｸｰｱｯｯｮｱｮｮｰｰｮｮｱｱｯｱｱｮｮｱｸｰｱｮｱｯｮｮｮｯｱｮｮｮｮｱｱｯｮｱｱｱｮｮｰｸｰｰｰｯｮｱｱｱｯｮｱｰｰｮｱｱｮｮｰｰｯｱｰｰｯｱｮｮｰｮｯｱｱｯｮｯｮｱｮｮｯｮｮｯｮｮｮｰｮｰｰｯｮｯｯｯｱｱｮｰｰｮｱｮｯｰｰｸｮｯｰｮｱｱｮｮｰｮｱｱｯｯｯｮｮｯｮｮｮｮｰｰｮｮｰｮｱｮｰｱｱｯｰｰｯｱｮｰｮｮｯｰｮｮｸｰｰｰｰｮｯｱｮｯｯｮｯｮｱｱｮｮｮｮｮｮｱｯｰｰｯｯｮｮｮｮｮｯｱｰｮｮｯｱｯｯｱｱｮｸｰｮｰｮｰｰｮｮｮｯｰｮｱｱｯｰｯｱｮｯｮｯｱｱｯｮｮｰｯｮｰｰｮｯｰｮｯｮｮｮｮｮｯｱｱｱｯｰｮｮｯｱｮｰｮｮｮｱｰｮｯｱｱｯｱｱｮｯｱｱｱｯｮｯｯｮｮｮｮｮｮｮｮｰｮｮｯｮｮｰｯｱｱｱｯｯｱｰｱｱｮｰｯｮｰｮｮｯｮｱｱｱｱｱｱｱｱｱｱｮｯｮｮｯｮｮｮｮｮｯｯｮｮｯｯｯｮｰｱｱｱｱｮｱｱｯｮｱｮｮｯｰｮｯｮｱｮｯｯｯｱｱｱｯｱｮｯｯｱｰｰｮｮｮｰｮｮｮｯｯｮｮｯｯｯｰｱｱｱｱｯｱｱｱｱｯｮｮｱｰｯｯｮｱｮｮｱｱｮｱｱｯｮｮｮｯｯｰｮｮｰｮｮｰｰｮｯｱｱｯｯｮｮｮｮｱｱｱｯｱｱｱｱｱｯｯｱｱｯｱｮｯｯｯｮｯｮｮｯｮｰｯｱｮｮｮｯｮｮｮｰｰｮｮｯｱｱｮｮｮｰｮｮｱｱｱｯｱｮｱｱｰｯｱｱｱｮｱｱｯｮｮｯｯｱｮｮｮｮｱｯｮｯｯｯｯｱｮｮｮｮｮｱｱｱｯｮｸｰｮｯｯｱｱｯｱｱｱｯｮｱｯｯｰｯｮｮｰｰｮｱｱｱｱｯｯｯｱｮｯｱｱｯｮｯｮｮｮｮｮｯｱｱｯｰｰｮｰｯｯｯｯｮｯｮｯｯｮｯｯｮｰｮｱｯｮｰｮｯｯｱｱｯｮｯｯｰｱｱｱｱｰｯｯｮｰｮｮｮｯｱｮｮｮｮｰｮｮｮｮｯｱｮｮｯｯｯｯｱｮｯｯｮｯｯｮｮｯｱｯｮｮｮｮｰｯｱｱｱｮｯｮｮｰｰｯｮｯｱｱｮｯｮｱｮｮｰｮｱｯｰｮｱｱｱｱｯｯｮｯｮｰｮｮｮｱｱｯｮｮｮｮｯｱｱｮｰｮｮｮｰｰｮｱｯｯｱｱｱｱｱｯｰｰｮｮｮｮｰｮｮｯｱｮｯｮｮｯｮｰｮｮｯｮｮｯｮｮｯｱｱｱｯｯｮｰｰｰｮｮｰｰｯｱｱｱｯｱｱｯｰｸｮｰｰｰｰｰｰｮｮｰｰｰｮｯｮｮｰｰｮｮｮｰｮｮｱｱｱｯｮｱｮｮｮｮｮｮｰｰｰｯｮｮｮｯｯｮｰｸｮｰｰｰｰｰｰｰｰｰｰｰｮｮｮｰｰｰｮｮｯｮｮｯｯｯｰｯｮｮｮｮｮｮｯｯｯｰｰｯｮｮｮｮｮｰｰｰｮｮｰｰｰｰｰｰｰｰｰｰｰｮｰｰｰｰｮｮｮｮｮｯｱｯｮｮｰｰｮｰｰｮｯｱｯｮｮｯｮｮｮｯｯｰｰｮｮｮｰｰｮｰｰｰｰｰｸｰｰｮｰｰｰｰｮｮｮｮｯｯｯｮｮｯｯｱｱｰｰｮｯｯｱｯｯｮｮｰｮｯｯｮｰｰｮｰｰｰｰｰｰｸｮｰｰｰｰｮｸｰｰｮｮｯｮｮｯｱｮｯｮｮｯｱｰｰｰｮｮｯｱｮｱｯｰｰｮｮｮｮｰｰｮｮｰｰｰｮｮｮｰｰｰｰｮｮｸｰｰｮｯｮｮｯｯｱｮｯｮｰｮｯｮｰｰｰｰｮｮｮｮｮｯｰｮｮｮｮｰｰｰｰｰｰｮｯｮｰｮｮｮｮｮｯｰｮｯｮｯｮｮｱｯｯｮｯｮｰｯｮｮｰｮｰｮｮｱｮｮｮｮｮｮｱｰｮｯｮｰｯｮｰｰｮｰｰｮｮｮｮｮｱｮｯｱｱｯｰｮｯｱｮｮｮｯｰｮｮｯｮｯｰｮｮｯｮｮｱｮｮｮｯｰｮｮｰｰｰｮｰｰｰｰｮｰｰｰｮｯｱｯｯｮｮｯｰｮｮｱｱｯｮｯｮｮｮｮｼｯﾆｻｻﾒﾆｱﾎｻｻｱｱｯｮｯｯｱｯｮｮｰｰｯｰｰｰｸｯｰｰｮｮｰｰｰｰｯｱｱｯｯｱｮｱｱｱｯｮｰｻｮｮﾒﾆｱﾆｻｻｮｰｯｯｮｯｯｰｮｸｰｰｮｮｰｰｮｱｰｰｮｯｸｸｰｯｯｯｮｯｯｯｮｱｱｱｯｸｸｮｰｮｱｮｮｱｯｯｯｰｰｮｮｮｯｮｱｯｮｱｯｮｮｮｮｮｮｮｯｱｱｯｯｰｮｮｮｮｮｯｱｯｯｮｮｰｰｮｮｯｱｱｱｯｱｯｮｮｮｮｮｯｯｮｱｯｮｮｯｯｮｮｮｰｮｯｯｱｱｱｱｮｰｮｯｮｮｯｱｯｮｮｱｰｰｰｮｮｱｯｯｱｱｱｯｯｮｮｮｮｯｮｮｯｮｰｱｱｮｮｰｮｮｮｯｯｱｱｱｯｮｮｮｮｯｯｯｱｮｯｱｰｰｰｰｮｯｮｯｱｱｯｯｮｰｮｮｰｮｮｮｱｱｮｱｯｮｮｮｮｯｯｮｮｯｯｯｮｮｮｮｮｯｮｮｯｰｮｮｰｮｮｮｮｯｯｱｱｱｯｮｮｮｯｮｮｰｮｰｮｱｮｯｮｮｮｮｯｱｯｮｮｯｯｯｮｯｯｯｮｮｯｮｮｰｮｮｰｮｮｯｮｯｯｮｯｯｮｯｮｮｯｱｯｮｮｯｱｱｯｮｯｯｯｯｱｱｯｮｮｱｱｯｮｮｯｯｮｮｮｮｯｯｮｯｰｰｯｯｯｮｮｮｯｯｯｯｮｮｮｯｯｮｮｯｱｱｯｯｯｮｯｮｯｱｮｮｯｱｱｯｮｮｯｯｯｯｮｯｱｱｯｯｮｰｮｯｮｯｯｱｯｮｯｯｮｮｮｯｯｮｮｮｯｯｯｯｯｯｮｮｱｱｱｯｮｮｮｮｮｮｱｮｮｮｱｱｱｯｱｱｯｮｮｯｮｮｮｮｮｯｮｯｮｮｯｮｯｯｯｯｮｯｸｮｰｸｮｰｸｮｯｮｰｰｮｱｯｱｱｱｰｸｰｰｮｱｱｯｮｮｮｯｯｮｯｯｮｯｯｯｮｮｯｮｮｮｯｮｮｯｮｮｰｮｰｰｰｯｮｮｮｮｮｱｱｱｰｮｮｰｰｮｮｱｯｯｮｮｮｮｮｮｯｯｮｯｮｮｮｮｮｮｮｯｯｮｮｯｮｮｮｰｰｰｯｯｮｯｱｯｮｱｱｮｸｮｯｰｰｰｰｮｮｯｱｱｮｰｮｯｯｯｮｮｮｯｮｮｮｰｮｯｮｰｰｮｮｰｮｰｮｮｯｮｯｮｯｱｱｮｮｮｰｮｰｰｰｰｸｰｮｮｱｱｮｮｮｮｯｱｮｯｮｯｮｯｮｯｯｰｮｮｯｮｯｮｮｮｮｮｯｮｯｯｯｱｮｮｮｰｰｰｸｸｮｰｸｸｰｰｯｯｮｮｮｮｮｮｮｮｮｮｮｯｯｯｯｮｮｯｱｱｯｮｱｯｮｯｯｰｮｱｱｯｱｯｮｰｰｮｰｸｮｮｸｰｮｰｮｯｮｮｯｮｮｯｮｯｮｮｮｯｮｱｱｯｱｯｱｱｯｱｯｮｮｮｯｮｮｱｮｮｯｱｯｰｯｮｰｰｯｮｰｮｰｸｮｯｱｯｯｱｯｯｮｯｯｮｱｯｮｱｱｯｯｯｱｯｮｮｯｰｮｮｮｮｯｮｯｮｮｮｱｱｱｮｮｮｯｮｸｰｮｮｮｮｱｯｮｱｱｮｮｮｮｯｯｱｮｯｯｱｯｯｯｮｮｰｮｰｮｮｰｮｮｮｯｯｮｮｮｱｱｮｮｰｮｮｰｰｮｮｱｮｮｮｯｱｮｮｰｰｰｯｯｯｮｮｯｱｱｯｱｮｮｮｯｮｰｰｮｮｮｰｯｯｮｮｰｯｱｮｯｰｰｰｰｰｮｰｮｮｮｯｮｯｮｰｸｰｰｮｱｱｮｯｱｱｱｱｱｯｮｮｯｰｮｯｯｮｮｰｮｱｯｮｮｮｯｮｯｯｯｮｮｰｸｰｮｮｮｯｮｰｰｰｰｰｰｮｮｱｮｱｱｱｱｯｱｮｰｯｮｮｮｯｮｰｮｰｰｯｯｮｮｯｱｰｱｱｱｮｮｰｸｰｱｮｮｮｯｰｰｮｰｮｰｰｮｱｯｱｯｯｯｮｯｰｮｯｮｮｯｱｮｮｯｮｰｯｯｮｮｯｯｮｯｯｯｮｮｮｰｮｱｯｯｱｮｰｯｯｯｮｮｰｰｱｯｯｱｮｮｮｮｰｮｮｯｯｱｱｯｯｯｮｮｮｯｮｮｮｮｮｯｰｰｮｮｰｮｱｯｯｯｱｱｮｯｮｮｮｯｮｮｯｮｮｮｮｯｮｯｮｰｯｯｯｯｯｯｯｱｯｮｯｯｮｮｮｮｮｮｮｰｯｯｮｮｮｱｮｮｯｯｯｯｰｮｮｰｮｯｮｯｱｮｰｰｮｯｯｰｮｯｮｯｯｯｱｱｮｮｯｯｮｮｮｯｮｯｮｰｯｮｰｰｮｱｮｰｯｯｮｮｰｰｰｮｯｯｮｮｮｮｮｮｮｯｮｰｯｮｯｯｱｱｯｮｯｮｯｮｮｮｮｱｯｯｯｮｮｮｮｮｮｱｯｮｮｯｯｯｮｰｰｱｱｯｮｯｮｮｮｮｯｯｰｮｮｮｯｮｯｯｯｮｱｯｮｮｯｯｯｱｯｱｯｯｮｮｮｮｮｮｯｮｮｯｯｮｯｮｮｯｯｯｯｯｱｯｮｮｮｮｮｮｮｯｮｮｱｯｯｮｯｮｮｮｯｯｮｮｮｯｱｮｮｮｰｮｮｯｮｮｮｮｮｮｮｮｯｮｮｮｮｯｯｯｯｮｯｮｮｯｮｮｮｮｱｮｮｮｯｮｰｯｯｮｮｮｮｮｮｮｰｮｮｰｰｱｮｯｱｯｰｮｮｮｯｱｮｮｮｯｮｯｮｮｯｱｯｮｰｮｮｯｱｯｰｰｮｮｰｯｮｮｮｮｮｯｯｮｮｮｰｰｮｱｯｯｯｮｮｮｮｱｯｯｯｯｮｯｮｮｮｰｯｱｮｮｮｮｯｱｱｯｰｮｰｰｮｯｮｮｮｮｰｯｮｯｱｮｮｮｮｱｯｱｯｯｯｮｮｱｯｯｯｯｯｯｮｰｮｰｯｱｮｯｮｮｯｯｱｯｰｮｰｮｮｯｮｰｮｮｮｯｮｮｯｮｮｮｮｯｯｱｯｯｮｮｯｯｯｯｯｮｯｯｮｮｮｮｯｱｯｯｯｮｮｯｱｮｯｯｮｮｮｮｱｮｮｮｯｯｮｰｯｯｮｰｮｯｯｯｱｯｮｮｮｯｯｱｯｯｯｯｯｮｮｮｮｱｯｯｯｰｯｱｱｯｯｱｱｮｮｮｱｮｮｰｮｮｮｮｯｮｮｰｰｮｮｮｯｮｰｮｮｮｮｱｯｯｯｯｯｮｮｮｯｯｱｮｮｮｱｱ